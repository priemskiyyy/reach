{
  "name": "example-shared",
  "private": true,
  "type": "module",
  "description": "The Darkroom domain shared by every example: accounts and the camera roll, the simulated phone, the in-page API, the Reach runtime and its policies, and the Tailwind styles.",
  "exports": {
    "./darkroom/*": "./darkroom/*.ts",
    "./phone/*": "./phone/*.ts",
    "./backend/*": "./backend/*.ts",
    "./lab/*": "./lab/*.ts",
    "./formatting/*": "./formatting/*.ts",
    "./types/*": "./types/*.ts",
    "./utils/*": "./utils/*.ts",
    "./ui/theme.css": "./ui/theme.css",
    "./ui/constants/*": "./ui/constants/*.ts",
    "./ui/styles/*": "./ui/styles/*.ts",
    "./ui/types/*": "./ui/types/*.ts"
  },
  "scripts": {
    "lint:typescript": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@priemskiyyy/reach": "workspace:*",
    "@priemskiyyy/reach-browser": "workspace:*",
    "@priemskiyyy/reach-http": "workspace:*",
    "class-variance-authority": "0.7.1",
    "ts-pattern": "5.9.0"
  }
}
