{
  "name": "@priemskiyyy/reach-svelte",
  "version": "0.1.0",
  "description": "Svelte bindings for Reach: utilities that read network state, conditions and endpoints without starting anything, and a provider that can hold a runtime lease.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/reach.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/reach/issues"
  },
  "homepage": "https://priemskiyyy.github.io/reach/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fixture.*",
    "!dist/**/*.contracts.*",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "lint:typescript": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project svelte"
  },
  "peerDependencies": {
    "@priemskiyyy/reach": ">=0.1.0 <0.2",
    "svelte": ">=5.7.0 <6"
  },
  "devDependencies": {
    "@priemskiyyy/reach": "workspace:*"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "runes",
    "connectivity",
    "network",
    "typescript",
    "reach"
  ]
}
