{
  "name": "@priemskiyyy/reach-react",
  "version": "0.1.0",
  "description": "React bindings for Reach: hooks that read network state, conditions and endpoints without starting anything, and a provider that can hold a runtime lease.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/reach.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/reach/issues"
  },
  "homepage": "https://priemskiyyy.github.io/reach/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project react"
  },
  "peerDependencies": {
    "@priemskiyyy/reach": ">=0.1.0 <0.2",
    "react": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@priemskiyyy/reach": "workspace:*"
  },
  "keywords": [
    "react",
    "react-native",
    "hooks",
    "connectivity",
    "network",
    "typescript",
    "reach"
  ]
}
