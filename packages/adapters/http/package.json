{
  "name": "@priemskiyyy/reach-http",
  "version": "0.1.0",
  "description": "HTTP endpoint checks for Reach through your own client: the request resolves with parsed data, your test reads it typed, and nothing is fetched until a check is demanded.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/reach.git",
    "directory": "packages/adapters/http"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/reach/issues"
  },
  "homepage": "https://priemskiyyy.github.io/reach/",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project http"
  },
  "peerDependencies": {
    "@priemskiyyy/reach": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/reach": "workspace:*"
  },
  "keywords": [
    "http",
    "health-check",
    "endpoint",
    "availability",
    "typescript",
    "reach",
    "adapter"
  ]
}
